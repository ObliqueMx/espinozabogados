---
import Eyebrow from './Eyebrow.astro';
import { OFICINAS, SITIO } from '../data/sitio';
import { MEXICO_D } from '../data/mexico';

interface Props { num: string }
const { num } = Astro.props;
---
<section class="wrap ubic" aria-labelledby="h-ubic">
  <div class="top">
    <div class="txt">
      <Eyebrow num={num} label="OFICINAS" class="rv" />
      <h2 id="h-ubic" class="h2 rv">Dos oficinas, <em>un mismo equipo.</em></h2>
      <p class="rv muted hint">Toca una oficina en el mapa para abrirla en Google Maps.</p>
    </div>
    <div class="rv map">
      <svg viewBox="0 0 1000 640" width="100%" aria-hidden="true">
        <path class="mx" d={MEXICO_D}></path>
        <path class="base" d="M588.7 467.4 Q 772.0 278.6 955.2 388.6"></path>
        <path class="route" d="M588.7 467.4 Q 772.0 278.6 955.2 388.6"></path>
        <circle class="halo" cx="588.7" cy="467.4" r="22"></circle><circle class="pin" cx="588.7" cy="467.4" r="9"></circle>
        <circle class="halo" cx="955.2" cy="388.6" r="22"></circle><circle class="pin" cx="955.2" cy="388.6" r="9"></circle>
      </svg>
      <a class="mxpin cdmx" href={OFICINAS[0].mapa} target="_blank" rel="noopener" aria-label="Oficina Ciudad de México: abrir en Google Maps (abre en otra pestaña)"><span class="mono mxlab">CDMX</span></a>
      <a class="mxpin cun" href={OFICINAS[1].mapa} target="_blank" rel="noopener" aria-label="Oficina Cancún: abrir en Google Maps (abre en otra pestaña)"><span class="mono mxlab">CANCÚN</span></a>
    </div>
  </div>
  <div class="grid">
    {OFICINAS.map((o) => (
      <div class="card corner rv of">
        <span class="mono gold">{o.num}</span>
        <span class="serif city">{o.ciudad}</span>
        <p class="muted">{o.direccion}</p>
        <a class="lnk ul strong bottom" href={o.mapa} target="_blank" rel="noopener">Cómo llegar → <span class="sr-only">(abre en otra pestaña)</span></a>
      </div>
    ))}
    <div class="dark rv of direct">
      <span class="mono acc">CONTACTO DIRECTO</span>
      <span class="serif city">Escríbenos</span>
      <a class="lnk ul strong" href={SITIO.telefonoHref}>{SITIO.telefono}</a>
      <a class="lnk ul strong" href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a>
      <a class="lnk ul strong" href={SITIO.whatsapp} target="_blank" rel="noopener">WhatsApp <span class="sr-only">(abre en otra pestaña)</span></a>
    </div>
  </div>
</section>

<style>
  .ubic { padding-top: clamp(56px, 8vw, 112px); padding-bottom: clamp(56px, 8vw, 112px); }
  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 24px clamp(24px, 4vw, 64px); margin-bottom: clamp(28px, 4vw, 48px); }
  .txt { flex: 1 1 300px; min-width: 0; }
  .hint { margin: 18px 0 0; max-width: 420px; font-size: 17px; }
  .map { position: relative; flex: 1.5 1 440px; min-width: 0; max-width: 720px; }
  svg { display: block; height: auto; overflow: visible; }
  .mx { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.4; stroke-linejoin: round; }
  .mxpin { position: absolute; display: block; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; color: var(--ink); text-decoration: none; outline-offset: 2px; }
  .mxpin:focus-visible { outline: 2px solid var(--gold); }
  .cdmx { left: 58.87%; top: 73.03%; }
  .cun { left: 95.52%; top: 60.72%; }
  .mxlab { position: absolute; font-size: 12px; letter-spacing: .14em; white-space: nowrap; }
  .cdmx .mxlab { right: calc(100% + 2px); top: 50%; transform: translateY(-50%); }
  .cun .mxlab { bottom: calc(100% - 4px); right: 0; }
  @media (hover: hover) and (pointer: fine) { .mxpin:hover .mxlab { text-decoration: underline; text-underline-offset: 4px; } }
  .base { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
  .route { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-dasharray: 10 14; stroke-linecap: round; }
  .halo { fill: var(--gold); opacity: .25; }
  .pin { fill: var(--ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .of { padding: 30px; display: flex; flex-direction: column; gap: 10px; }
  .of p { margin: 0; font-size: 16px; }
  .city { font-size: 36px; line-height: 1; }
  .bottom { margin-top: auto; }
  .direct { border-radius: 22px; }
  .acc { color: var(--dark-accent); }
  @media (prefers-reduced-motion: no-preference) {
    .route { animation: dash 1.8s linear infinite; }
  }
</style>
