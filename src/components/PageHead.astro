---
// Encabezado verde de las páginas interiores: migas, eyebrow, titular e introducción.
import Icono from './Icono.astro';
import Eyebrow from './Eyebrow.astro';
import type { Icono as IconoName } from '../data/iconos';
import { RUTAS } from '../data/sitio';

interface Props {
  num: string;
  eyebrow: string;
  // Titular: `a` normal + `em` en cursiva.
  a: string;
  em?: string;
  intro: string;
  icon?: IconoName;
  // Migas intermedias entre "Inicio" y la página actual.
  migas?: { label: string; href?: string }[];
  actual: string;
}
const { num, eyebrow, a, em, intro, icon, migas = [], actual } = Astro.props;
const trail = [{ label: 'Inicio', href: RUTAS.inicio }, ...migas];
---
<section class="ph">
  <div class="wrap inner">
    <nav aria-label="Ruta" class="crumbs mono in">
      {trail.map((m) => (
        <>
          {m.href ? <a class="lnk ul" href={m.href}>{m.label}</a> : <span>{m.label}</span>}
          <span aria-hidden="true">/</span>
        </>
      ))}
      <span aria-current="page" class="here">{actual}</span>
    </nav>
    <Eyebrow num={num} label={eyebrow} animar class="in d1 eb" />
    <div class="row">
      {icon && <span class="chip ico in d2"><Icono name={icon} size={38} stroke={1.4} /></span>}
      <div class="txt">
        <h1 class="in d2">{a}{em && <em>{em}</em>}</h1>
        <p class="in d3">{intro}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ph { position: relative; overflow: hidden; background-color: var(--dark-deep); background-image: radial-gradient(80% 90% at 80% 30%, var(--dark-panel) 0%, var(--dark-deep) 75%); color: var(--dark-ink); border-bottom: 1px solid var(--dark-line); }
  .inner { position: relative; z-index: 2; padding-top: clamp(24px, 4vw, 40px); padding-bottom: clamp(40px, 6vw, 72px); }
  .crumbs { letter-spacing: .08em; color: var(--dark-muted); display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(32px, 6vw, 72px); }
  .here { color: var(--dark-ink); }
  .ph :global(.eb) { margin-bottom: 18px; }
  .ph :global(.eb .num) { color: var(--dark-accent); }
  .ph :global(.eb .line) { background: var(--dark-line); }
  .row { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .ico { width: 80px; height: 80px; border-radius: 24px; background: transparent; color: var(--dark-accent); border: 1px solid var(--dark-line); }
  .txt { flex: 1 1 480px; min-width: 0; }
  h1 { margin: 0; max-width: 960px; font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 6vw, 88px); line-height: 1; letter-spacing: -.025em; }
  h1 em { color: var(--dark-accent); }
  .txt p { margin: 22px 0 0; max-width: 640px; font-size: clamp(18px, 1.6vw, 21px); color: var(--dark-muted); }
</style>
