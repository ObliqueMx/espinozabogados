---
// Esqueleto de todas las páginas: <head> con SEO, encabezado, pie y botón de WhatsApp.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITIO, OFICINAS, RUTAS, ruta } from '../data/sitio';
import type { ComponentProps } from 'astro/types';

interface Props {
  title: string;
  description: string;
  activo?: ComponentProps<typeof Header>['activo'];
}
const { title, description, activo } = Astro.props;
const fullTitle = Astro.url.pathname === RUTAS.inicio ? title : `${title} · ${SITIO.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/hero-poster.jpg', Astro.site);
// Datos estructurados de la firma (schema.org). Es un bloque de datos, no un script: la CSP no lo bloquea.
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: SITIO.nombre,
  legalName: SITIO.razonSocial,
  url: SITIO.url,
  telephone: '+52 55 5419 9450',
  email: SITIO.correo,
  image: ogImage.href,
  areaServed: 'MX',
  location: OFICINAS.map((o) => ({ '@type': 'Place', name: o.ciudad, address: o.direccion }))
});
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#123528">
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')}>
  <link rel="icon" type="image/png" href={ruta('/favicon.png')}>
  <link rel="apple-touch-icon" href={ruta('/favicon.png')}>
  <link rel="sitemap" href={ruta('/sitemap-index.xml')}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_MX">
  <meta property="og:site_name" content={SITIO.nombre}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={ld} />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Header activo={activo} />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style>
  .skip { position: absolute; left: 16px; top: -100px; z-index: 100; padding: 12px 18px; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 600; text-decoration: none; }
  .skip:focus { top: 12px; }
</style>
