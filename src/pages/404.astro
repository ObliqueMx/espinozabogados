---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaFinal from '../components/CtaFinal.astro';
---
<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección.">
  <PageHead num="404" eyebrow="NO ENCONTRADA" a="Esta página " em="no existe." actual="404" intro="Puede que el enlace esté mal escrito o que la página haya cambiado de dirección. Usa el menú para encontrar lo que buscas." />
  <div class="sp"></div>
  <CtaFinal />
</Base>

<style>
  .sp { height: clamp(56px, 8vw, 104px); }
</style>
