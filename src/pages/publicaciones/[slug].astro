---
// Una ruta para dos tipos de página: filtros (/publicaciones/forum/) y publicaciones (/publicaciones/a1/).
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ListaPublicaciones from '../../components/ListaPublicaciones.astro';
import LectorPdf from '../../components/LectorPdf.astro';
import Boletin from '../../components/Boletin.astro';
import Icono from '../../components/Icono.astro';
import { RUTAS } from '../../data/sitio';
import { FILTROS, PUBLICACIONES, TIPOS, paginas, type Publicacion, type TipoPub } from '../../data/publicaciones';

export const getStaticPaths = (() => [
  ...FILTROS.map((f) => ({ params: { slug: TIPOS[f.tipo].slug }, props: { filtro: f.tipo, title: f.title, desc: f.desc } })),
  ...PUBLICACIONES.map((p) => ({ params: { slug: p.id }, props: { pub: p } }))
]) satisfies GetStaticPaths;

const { filtro, title, desc, pub } = Astro.props as { filtro?: TipoPub; title?: string; desc?: string; pub?: Publicacion };
const otras = pub ? PUBLICACIONES.filter((x) => x.id !== pub.id).slice(0, 3) : [];
const intro = 'Los artículos que publicamos en la Revista FORUM y lo nuevo de los tribunales explicado en simple: Poder Judicial de la Federación cada semana y Tribunal Federal de Justicia Administrativa cada mes.';
---
{filtro && (
  <Base title={title!} description={desc!} activo="publicaciones">
    <PageHead num="04" eyebrow="PUBLICACIONES" a="Nuestras " em="publicaciones." actual="Publicaciones" intro={intro} />
    <ListaPublicaciones filtro={filtro} />
    <Boletin />
  </Base>
)}
{pub && (
  <Base title={pub.title} description={`${TIPOS[pub.tipo].tag}${pub.autor ? ` de ${pub.autor}` : ''}: ${pub.title}. Léelo en línea o descárgalo en PDF.`} activo="publicaciones">
    <PageHead num="04" eyebrow={`${TIPOS[pub.tipo].tagUp} · ${pub.date}`} a={pub.title} actual={TIPOS[pub.tipo].crumb}
      migas={[{ label: 'Publicaciones', href: RUTAS.publicaciones }]} intro={`${pub.autor ? `Por ${pub.autor}. ` : ''}${paginas(pub)} ${paginas(pub) === 1 ? 'página' : 'páginas'}. Léelo aquí o descárgalo en PDF.`} />
    <section class="wrap pg">
      <LectorPdf p={pub} />
      <aside>
        <div class="rv stick">
          <div class="dark ask">
            <p class="serif">¿Esto aplica a tu caso?</p>
            <p class="muted">Revisamos tu caso y te decimos qué hacer.</p>
            <a class="lnk btn pill light" href={RUTAS.diagnostico}><span>Agenda un diagnóstico<span class="hide-sm"> preventivo</span></span><Icono name="arrow" size={15} stroke={2.2} class="arr" /></a>
          </div>
          <p class="mono mas">MÁS PUBLICACIONES</p>
          {otras.map((o) => (
            <a class="lnk srow mini" href={RUTAS.publicacion(o.id)}>
              <span class="mono muted">{TIPOS[o.tipo].tagUp} · {o.date}</span>
              <span class="serif">{o.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </section>
    <Boletin />
  </Base>
)}

<style>
  .pg { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(56px, 8vw, 104px); display: flex; flex-wrap: wrap; gap: 40px 72px; }
  aside { flex: 1 1 280px; min-width: 0; }
  .stick { position: sticky; top: 100px; }
  .ask { padding: 28px; border-radius: 24px; }
  .ask p { margin: 0; }
  .ask .serif { font-size: 30px; line-height: 1.05; }
  .ask .muted { margin: 10px 0 20px; font-size: 16px; }
  .ask .pill { padding: 14px 18px; font-size: 15px; }
  .mas { margin: 32px 0 6px; }
  .mini { display: block; padding: 16px 0; border-bottom-color: var(--line); }
  .mini .mono { display: block; letter-spacing: .1em; }
  .mini .serif { display: block; margin-top: 4px; font-size: 24px; line-height: 1.1; }
</style>
