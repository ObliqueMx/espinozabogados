---
import LinkedIn from '../components/LinkedIn.astro';
import Base from '../layouts/Base.astro';
import { Image, Picture } from 'astro:assets';
import retrato from '../assets/paolo-espinoza.jpg';
import Icono from '../components/Icono.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ListasBand from '../components/ListasBand.astro';
import Boletin from '../components/Boletin.astro';
import Oficinas from '../components/Oficinas.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { RUTAS, ruta } from '../data/sitio';
import { SERVICIOS, URGENCIAS } from '../data/servicios';
import { PUBS_INICIO, TIPOS, paginas } from '../data/publicaciones';

const heroText = 'Defendemos tu modelo de negocio para conservar la credibilidad en la toma de decisiones.';
---
<Base
  title="Espinoza Abogados · Asesoría y litigio fiscal en CDMX y Cancún"
  description="Firma boutique de derecho fiscal. Prevenimos problemas con el SAT y, cuando ya existen, los resolvemos: sello digital, listas 69-B y 49 Bis, créditos fiscales, auditorías y PLD."
>
  <section class="dark hero" data-hero>
    <video class="hv" src={ruta('/hero.mp4')} poster={ruta('/hero-poster.jpg')} autoplay muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1"></video>
    <div class="tint" aria-hidden="true"></div>
    <div class="shade" aria-hidden="true"></div>
    <button type="button" class="hv-btn" aria-label="Pausar o reanudar el video de fondo" aria-pressed="false" data-hero-btn>
      <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"></path></svg>
      <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
    </button>
    <div class="wrap hero-grid">
      <div class="h-text">
        <p class="in mono pre"><span class="live dotlive" aria-hidden="true"></span>ASESORÍA TRIBUTARIA</p>
        <h1 aria-label={heroText}>
          {heroText.split(' ').map((w) => (
            <span class="w" aria-hidden="true">
              <span class:list={['wd', { em: w === 'credibilidad' }]}>{w}</span>
              {w === 'credibilidad' && (
                <svg viewBox="0 0 200 14" preserveAspectRatio="none" class="swash"><path class="draw" pathLength="1" d="M3 9 C 48 3, 112 13, 197 5"></path></svg>
              )}
            </span>
          ))}
        </h1>
      </div>
      <div class="in d3 h-card">
        <div class="glass">
          <p class="mono muted">MÁS DE</p>
          <p class="serif yrs">20 años</p>
          <p class="serif l1">de trayectoria.</p>
          <p class="serif l2">Firma fundada en 2026.</p>
          <p class="mono muted cities">CDMX · CANCÚN</p>
        </div>
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="wrap mono muted">
      <span>EMPRESAS Y PERSONAS FÍSICAS</span><span>PUBLICADO EN FORUM</span><span>CDMX · CANCÚN</span>
    </div>
  </div>

  <section class="wrap urg" aria-labelledby="h-urg">
    <Eyebrow num="01" label="TU URGENCIA" animar class="rv" />
    <div class="urg-grid">
      <div class="urg-head">
        <h2 id="h-urg" class="h2 rv">¿Qué te preocupa <em>hoy</em>?</h2>
        <p class="muted">Elige tu caso. Te explicamos qué significa y qué puedes hacer.</p>
      </div>
      {URGENCIAS.map((u) => (
        <a class="lnk card inv corner rv ucard" href={u.href}>
          <span class="top">
            <span class="chip"><Icono name={u.icon} size={26} stroke={1.6} /></span>
            <span aria-hidden="true" class="mono gold n">{u.num}</span>
          </span>
          <span class="clamp2 tt">{u.title}</span>
          <span class="muted sh"><span class="clamp3">{u.short}</span></span>
          <span class="go">Qué hacer <Icono name="arrow" size={16} stroke={2} class="arr" /></span>
        </a>
      ))}
    </div>
  </section>

  <ListasBand num="02" conEnlace />

  <section class="wrap serv" aria-labelledby="h-serv">
    <Eyebrow num="03" label="SERVICIOS" class="rv" />
    <h2 id="h-serv" class="h2 rv">Qué <em>hacemos.</em></h2>
    <p class="muted sub">Prevenimos problemas fiscales y, cuando ya existen, los resolvemos.</p>
    <div class="list-rows">
      {SERVICIOS.map((s) => (
        <a class="lnk srow rv svc-row" href={RUTAS.servicio(s.id)}>
          <span class="num">{s.num}</span>
          <span class="chip hide-sm sico"><Icono name={s.icon} size={22} /></span>
          <span class="serif s-name">{s.name}</span>
          <span class="muted s-desc">{s.short}</span>
          <span class="ring"><Icono name="arrow" size={18} stroke={2} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="pubs" aria-labelledby="h-al">
    <div class="wrap">
      <Eyebrow num="04" label="PUBLICACIONES" class="rv" />
      <div class="pubs-head">
        <h2 id="h-al" class="h2 rv">Publicaciones <em>recientes.</em></h2>
        <a class="lnk ul strong" href={RUTAS.publicaciones}>Ver todas las publicaciones →</a>
      </div>
      <div class="pubs-grid">
        {PUBS_INICIO.map((p) => (
          <a class="lnk card corner rv pcard" href={RUTAS.publicacion(p.id)}>
            <span class="mono meta"><span class="tag"><span class:list={['dot', p.tipo]}></span>{TIPOS[p.tipo].tagUp}</span><span class="muted">{p.date}</span></span>
            <span class="pcov"><Image src={p.doc.pages[0]} alt="" widths={[400, 800]} sizes="(max-width: 640px) 100vw, 400px" /></span>
            <span class="grow"><span class="clamp2 serif pt">{p.title}</span></span>
            <span class="go">Leer · {paginas(p)} págs. <Icono name="arrow" size={16} stroke={2} class="arr" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap firma" aria-labelledby="h-firma">
    <Eyebrow num="05" label="LA FIRMA" class="rv eb" />
    <div class="firma-row">
      <div class="rv frame foto"><Picture class="retrato" src={retrato} formats={['avif', 'webp']} alt="Paolo Espinoza, socio director de Espinoza Abogados" widths={[400, 800]} sizes="340px" draggable="false" /></div>
      <div class="firma-txt">
        <h2 id="h-firma" class="rv">Quiénes <em>somos.</em></h2>
        <p class="muted">Somos una firma boutique. Prevenimos problemas fiscales y administrativos, y cuando ya existen, los resolvemos ante autoridades federales, estatales y municipales.</p>
        <div class="socio">
          <p class="serif">Paolo Espinoza</p>
          <p class="muted">Socio director · Abogado especialista en derecho fiscal, Universidad Panamericana.</p>
        </div>
        <div class="btns">
          <a class="lnk btn pill" href={RUTAS.firma}>Conoce la firma<Icono name="arrow" size={15} stroke={2.2} class="arr" /></a>
          <LinkedIn />
        </div>
      </div>
    </div>
  </section>

  <Boletin />
  <Oficinas num="06" />
  <CtaFinal />
</Base>

<script>
  // Video del hero: respeta "reducir movimiento" y el botón de pausa.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const v = hero?.querySelector('video');
  if (hero && v) {
    const show = () => v.classList.add('on');
    v.addEventListener('playing', show);
    v.addEventListener('loadeddata', show);
    // Si viene de caché, los eventos ya pasaron antes de que este script corriera.
    if (v.readyState >= 2) show();
    const btn = hero.querySelector<HTMLButtonElement>('[data-hero-btn]')!;
    const paused = (p: boolean) => { hero.classList.toggle('paused', p); btn.setAttribute('aria-pressed', String(p)); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.pause();
      paused(true);
    } else {
      v.play().catch(() => {});
    }
    btn.addEventListener('click', () => {
      if (v.paused) { v.play().catch(() => {}); paused(false); } else { v.pause(); paused(true); }
    });
  }
</script>

<style>
  /* Hero con video: la toma va en blanco y negro y se entinta con el verde de la paleta */
  .hero { position: relative; overflow: hidden; background: radial-gradient(80% 90% at 80% 30%, var(--dark-panel) 0%, var(--dark-deep) 75%); }
  .hv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15) brightness(.8); opacity: 0; transition: opacity 1.2s ease; pointer-events: none; }
  .hv:global(.on) { opacity: 1; }
  .tint { position: absolute; inset: 0; mix-blend-mode: color; pointer-events: none; background: var(--dark); }
  .shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, #0D261DF0 0%, #0D261DB3 45%, #0D261D40 100%), linear-gradient(0deg, var(--dark-deep) 0%, #0D261D00 35%); }
  .hv-btn { position: absolute; right: max(24px, calc(50% - 596px)); top: 20px; z-index: 3; width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: transparent; cursor: pointer; opacity: .75; transition: opacity .2s; border: 1px solid var(--dark-line); color: var(--dark-ink); }
  .hv-btn:hover, .hv-btn:focus-visible { opacity: 1; }
  .i-play, .hero:global(.paused) .i-pause { display: none; }
  .hero:global(.paused) .i-play { display: block; }

  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); grid-template-areas: "text card"; column-gap: 56px; row-gap: clamp(12px, 3vh, 36px); align-items: center; min-height: min(calc(100svh - 80px), 900px); padding-top: clamp(40px, 8vh, 96px); padding-bottom: clamp(72px, 10vh, 112px); }
  .h-text { grid-area: text; min-width: 0; }
  .h-card { grid-area: card; justify-self: end; min-width: 0; width: 100%; max-width: 340px; position: relative; padding: 14px; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "text" "card"; min-height: 0; }
    .h-card { justify-self: center; margin: 8px 0 52px; }
  }
  .pre { margin: 0 0 20px; display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 10px; border-radius: 999px; border: 1px solid var(--dark-line); letter-spacing: .1em; }
  .dotlive { width: 8px; height: 8px; border-radius: 50%; background: var(--dark-accent); }
  h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(36px, min(4.2vw, 6.6vh), 68px); line-height: 1.02; letter-spacing: -.025em; }
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .12em; margin-right: .22em; position: relative; }
  .wd { display: inline-block; }
  .wd.em { color: var(--dark-gold); font-style: italic; }
  /* Las palabras suben una tras otra: 0.2s + 0.06s por palabra */
  .w:nth-child(1) .wd { animation-delay: .2s; } .w:nth-child(2) .wd { animation-delay: .26s; } .w:nth-child(3) .wd { animation-delay: .32s; }
  .w:nth-child(4) .wd { animation-delay: .38s; } .w:nth-child(5) .wd { animation-delay: .44s; } .w:nth-child(6) .wd { animation-delay: .5s; }
  .w:nth-child(7) .wd { animation-delay: .56s; } .w:nth-child(8) .wd { animation-delay: .62s; } .w:nth-child(9) .wd { animation-delay: .68s; }
  .w:nth-child(10) .wd { animation-delay: .74s; } .w:nth-child(11) .wd { animation-delay: .8s; } .w:nth-child(12) .wd { animation-delay: .86s; }
  .w:nth-child(13) .wd { animation-delay: .92s; } .w:nth-child(n+14) .wd { animation-delay: .98s; }
  .swash { position: absolute; left: 0; bottom: 0; width: 100%; height: .2em; overflow: visible; }
  .swash path { fill: none; stroke: var(--dark-gold); stroke-width: 3.5; stroke-linecap: round; }

  .glass { position: relative; background: #12352899; border: 1px solid var(--dark-line); border-radius: 24px; padding: 24px 24px 22px; box-shadow: 0 40px 70px -40px rgba(0, 0, 0, .6); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .glass::before, .glass::after { content: ""; position: absolute; width: 34px; height: 34px; }
  .glass::before { top: -12px; left: -12px; border-top: 2px solid var(--dark-accent); border-left: 2px solid var(--dark-accent); }
  .glass::after { bottom: -12px; right: -12px; border-bottom: 2px solid var(--dark-accent); border-right: 2px solid var(--dark-accent); }
  .glass p { margin: 0; }
  .glass .mono { color: var(--dark-muted); }
  .yrs { margin-top: 6px !important; font-size: clamp(56px, 5vw, 76px); line-height: .9; color: var(--dark-accent); }
  .l1 { margin-top: 10px !important; font-size: 24px; line-height: 1.1; }
  .l2 { margin-top: 18px !important; padding-top: 14px; border-top: 1px solid var(--dark-line); font-size: 20px; line-height: 1.15; }
  .cities { margin-top: 12px !important; }

  .trust { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .trust .wrap { padding-top: 20px; padding-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px 32px; letter-spacing: .12em; }

  .urg { position: relative; padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(48px, 6vw, 88px); }
  .urg-grid { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); grid-auto-rows: 1fr; gap: 14px; }
  .urg-head { display: flex; flex-direction: column; justify-content: flex-end; padding: 0 12px 8px 0; min-height: 200px; }
  .urg-head h2 { margin-bottom: 12px; }
  .urg-head p { margin: 0; max-width: 360px; }
  @media (max-width: 661px) {
    .urg-grid { grid-auto-rows: auto; }
    .urg-head { min-height: 0; }
  }
  .ucard { display: flex; flex-direction: column; gap: 14px; padding: 26px 24px 24px; min-height: 260px; height: 100%; width: 100%; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; width: 100%; }
  .ucard .chip { width: 52px; height: 52px; border-radius: 16px; }
  .n { font-size: 13px; letter-spacing: .1em; }
  .tt { font-size: 20px; font-weight: 600; line-height: 1.25; }
  .sh { font-size: 16px; flex: 1; }
  .go { font-size: 15px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }

  .serv { position: relative; padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(56px, 8vw, 120px); }
  .serv h2 { margin-bottom: 10px; }
  .sub { margin: 0 0 36px; max-width: 600px; }
  .svc-row { flex-wrap: wrap; gap: 10px 24px; padding: 26px 0; }
  .sico { width: 46px; height: 46px; border-radius: 14px; }
  .s-name { flex: 1 1 260px; font-size: clamp(28px, 3.2vw, 42px); line-height: 1.05; }
  .s-desc { flex: 1 1 300px; font-size: 16px; }
  .svc-row .ring { width: 48px; height: 48px; }
  @media (max-width: 640px) {
    .svc-row { gap: 10px 12px; }
    .svc-row .num { flex: 0 0 22px; }
    .s-name { flex: 1 1 0; min-width: 0; }
    .s-desc { order: 1; flex: 1 1 100%; }
  }

  .pubs { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pubs .wrap { padding-top: clamp(56px, 8vw, 112px); padding-bottom: clamp(56px, 8vw, 112px); }
  .pubs-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 34px; }
  .pubs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); grid-auto-rows: 1fr; gap: 14px; }
  .pcard { display: flex; flex-direction: column; gap: 16px; padding: 28px; background: var(--bg); min-height: 250px; height: 100%; width: 100%; }
  .meta { display: flex; justify-content: space-between; gap: 12px; width: 100%; letter-spacing: .12em; }
  .tag { display: inline-flex; align-items: center; gap: 8px; }
  .pcard .pcov { width: 100%; height: 150px; border-radius: 10px; }
  .grow { flex: 1; }
  .pt { font-size: 28px; line-height: 1.1; }

  .firma { position: relative; padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(56px, 8vw, 120px); }
  .firma :global(.eb) { margin-bottom: 24px; }
  .firma-row { display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: center; }
  .foto { flex: 0 1 340px; min-width: 0; }
  .firma-txt { flex: 1.15 1 420px; min-width: 0; padding-top: 14px; }
  .firma-txt h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 4.2vw, 60px); line-height: 1.02; letter-spacing: -.02em; }
  .firma-txt > p { margin: 20px 0 0; max-width: 560px; }
  .socio { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); }
  .socio p { margin: 0; }
  .socio .serif { font-size: 30px; line-height: 1.1; }
  .socio .muted { margin-top: 4px; font-size: 16px; }
  .btns { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 10px; }
  .btns .pill { min-height: 46px; padding: 0 20px; font-size: 15px; }
</style>
